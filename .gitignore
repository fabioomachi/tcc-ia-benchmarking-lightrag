# Ambientes virtuais
.venv/
venv/
env/

# Python cache & bytecode
__pycache__/
*.py[cod]
*$py.class
*.so

# Testes e cobertura
.pytest_cache/
.coverage
htmlcov/

# Linters e formatadores
