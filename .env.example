# -----------------------------------------------------------------------------
# Configurações do Ollama / Infraestrutura de Modelos
# -----------------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434/v1/
OLLAMA_API_KEY=ollama_local

# Modelos do Motor RAG
RAG_LLM_MODEL=qwen2.5:3b
RAG_EMBED_MODEL=all-minilm
RAG_EMBED_DIM=384

# Modelos do Framework Avaliador (RAGAS)
RAGAS_JUDGE_MODEL=qwen2.5:7b
RAGAS_EMBED_MODEL=nomic-embed-text
RAGAS_NUM_CTX=8192
RAGAS_TIMEOUT=1200

# -----------------------------------------------------------------------------
# Parâmetros de Execução & Benchmarking
# -----------------------------------------------------------------------------
BENCHMARK_CONCURRENCY=10
BENCHMARK_HISTORY_TURNS=3
BENCHMARK_CACHE_THRESHOLD=0.92
BENCHMARK_DEFAULT_MODE=hybrid
BENCHMARK_DEFAULT_TOP_K=5

# -----------------------------------------------------------------------------
# Diretórios de Dados & Armazenamento
# -----------------------------------------------------------------------------
DATA_DIR=entradas
POPS_DIR=entradas/pops
QUESTIONS_DIR=entradas/perguntas
STORAGE_DIR=lightrag_ollama_db
RUNS_DIR=runs
LOGS_DIR=logs
RESULT_DIR=resultados
