# -----------------------------------------------------------------------------
# Configurações do Ollama / Infraestrutura de Modelos
# -----------------------------------------------------------------------------
OLLAMA__BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
OLLAMA__API_KEY=ollama_local
OLLAMA__REQUEST_TIMEOUT=600.0
OLLAMA__MAX_RETRIES=3
OLLAMA__CONNECT_TIMEOUT=10.0
OPENAI_MAX_RETRIES=5

# Rate-limit / completion / retry
OLLAMA__RATE_LIMIT_INTERVAL_SECONDS=4.2
OLLAMA__COMPLETION_MAX_ATTEMPTS=6
OLLAMA__COMPLETION_MAX_TOKENS=8192
OLLAMA__COMPLETION_DEFAULT_TEMPERATURE=0.0
OLLAMA__RETRY_INITIAL_DELAY=5.0
OLLAMA__RETRY_BACKOFF_FACTOR=2.0
OLLAMA__RETRY_MAX_DELAY=60.0
OLLAMA__RETRY_BACKOFF=3.0
OLLAMA__RETRY_JITTER_MIN=2.0

# Embeddings via REST
OLLAMA__EMBEDDING_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta/models
OLLAMA__EMBEDDING_API_MODEL=gemini-3.1-flash-lite
OLLAMA__EMBEDDING_DEFAULT_DIM=768
OLLAMA__EMBEDDING_MAX_CONCURRENCY=3
OLLAMA__EMBEDDING_MAX_ATTEMPTS=3
OLLAMA__EMBEDDING_TIMEOUT=10.0
OLLAMA__EMBEDDING_RETRY_DELAY=2.0
OLLAMA__EMBEDDING_RETRY_SHORT_DELAY=1.0
OLLAMA__EMBEDDING_BATCH_SIZE=5
OLLAMA__EMBEDDING_MICRO_PAUSE=0.3

# Modelos do Motor RAG (LightRAG) — INDEX (config testada, Gemini)
LIGHTRAG__LLM_MODEL=gemini-3.1-flash-lite
LIGHTRAG__EMBED_MODEL=gemini-embedding-001
LIGHTRAG__EMBED_DIM=768
LIGHTRAG__DEFAULT_MODE=hybrid
LIGHTRAG__DEFAULT_TOP_K=5
LIGHTRAG__LLM_TEMPERATURE=0.0
LIGHTRAG__LLM_MAX_TOKEN_SIZE=8192
LIGHTRAG__EMBEDDING_MAX_TOKEN_SIZE=16384
LIGHTRAG__DEFAULT_LLM_TIMEOUT=2400
LIGHTRAG__LLM_MODEL_MAX_ASYNC=1
LIGHTRAG__EMBEDDING_FUNC_TIMEOUT=600
LIGHTRAG__EMBEDDING_FUNC_MAX_ASYNC=4
LIGHTRAG__LANGUAGE=Portuguese
# Workers do CHAT (usados quando role="chat")
LIGHTRAG__CHAT_DEFAULT_LLM_TIMEOUT=60
LIGHTRAG__CHAT_LLM_MODEL_MAX_ASYNC=4
LIGHTRAG__CHAT_LLM_FUNC_TIMEOUT=60
LIGHTRAG__CHAT_EMBEDDING_FUNC_TIMEOUT=600
LIGHTRAG__CHAT_EMBEDDING_FUNC_MAX_ASYNC=8

# Chat / query local (Ollama) — CHAT e RUN usam este modelo
CHAT__BASE_URL=http://localhost:11434/v1/
CHAT__API_KEY=ollama
CHAT__LLM_MODEL=qwen3.5:4b
CHAT__EMBED_MODEL=embeddinggemma
CHAT__EMBED_DIM=768
CHAT__TEMPERATURE=0.0
CHAT__MAX_TOKENS=8192
CHAT__NUM_CTX=8192
CHAT__REQUEST_TIMEOUT=900.0
CHAT__MAX_RETRIES=3
CHAT__CONNECT_TIMEOUT=10.0

# Modelos do Framework Avaliador (RAGAS / LLM-as-a-Judge)
RAGAS__JUDGE_MODEL=qwen2.5:7b
RAGAS__EMBED_MODEL=embeddinggemma
RAGAS__NUM_CTX=8192
RAGAS__TIMEOUT=1200
RAGAS__MAX_WORKERS=1

# -----------------------------------------------------------------------------
# Parâmetros de Execução & Benchmarking
# -----------------------------------------------------------------------------
CONCURRENCY_LIMIT=10
HISTORY_TURNS=3
CACHE_THRESHOLD=0.92

# -----------------------------------------------------------------------------
# Diretórios de Dados & Armazenamento (relativos ao root do projeto)
# -----------------------------------------------------------------------------
POPS_DIR=data/pops
QUESTIONS_DIR=data
STORAGE_DIR=lightrag_ollama_db
RUNS_DIR=runs
